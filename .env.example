# Cracked — local environment template. Copy to .env (which is gitignored).
#
#   cp .env.example .env
#   npm run db:reset     # prisma db push --force-reset && npm run db:seed

# SQLite, relative to prisma/. Creates prisma/dev.db.
DATABASE_URL="file:./dev.db"

# Anthropic API key for the runtime agents (Tracks C/D). Not needed for db work.
ANTHROPIC_API_KEY=""
